CREATE TABLE virtual_notification (
    id TEXT NOT NULL PRIMARY KEY,
    source_key TEXT NOT NULL UNIQUE,
    source_app_id TEXT NOT NULL,
    title TEXT NOT NULL,
    body TEXT NOT NULL,
    character_id TEXT,
    timestamp_epoch_ms INTEGER NOT NULL,
    priority TEXT NOT NULL,
    category TEXT NOT NULL,
    route TEXT,
    seen INTEGER NOT NULL DEFAULT 0,
    dismissed INTEGER NOT NULL DEFAULT 0
);

selectActiveNotifications:
SELECT * FROM virtual_notification WHERE dismissed = 0
ORDER BY timestamp_epoch_ms DESC, id DESC;

selectNotificationBySourceKey:
SELECT * FROM virtual_notification WHERE source_key = ?;

insertNotification:
INSERT OR IGNORE INTO virtual_notification (
    id, source_key, source_app_id, title, body, character_id,
    timestamp_epoch_ms, priority, category, route, seen, dismissed
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectInsertedNotificationCount:
SELECT changes();

markNotificationSeen:
UPDATE virtual_notification SET seen = 1 WHERE id = ?;

dismissNotification:
UPDATE virtual_notification SET dismissed = 1, seen = 1 WHERE id = ?;

clearDismissibleNotifications:
UPDATE virtual_notification SET dismissed = 1, seen = 1 WHERE dismissed = 0;
