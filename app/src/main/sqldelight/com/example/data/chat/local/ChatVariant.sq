CREATE TABLE chat_variant (
    id TEXT NOT NULL PRIMARY KEY,
    turn_id TEXT NOT NULL,
    variant_index INTEGER NOT NULL,
    content TEXT NOT NULL,
    status TEXT NOT NULL,
    provider_profile_id TEXT,
    model TEXT,
    error_type TEXT,
    error_message TEXT,
    created_at_epoch_ms INTEGER NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL,
    FOREIGN KEY(turn_id) REFERENCES chat_turn(id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX chat_variant_turn_index ON chat_variant(turn_id, variant_index);

insertVariant:
INSERT INTO chat_variant(id, turn_id, variant_index, content, status, provider_profile_id, model, error_type, error_message, created_at_epoch_ms, updated_at_epoch_ms)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectVariantsByTurn:
SELECT * FROM chat_variant WHERE turn_id = ? ORDER BY variant_index ASC;

selectVariantById:
SELECT * FROM chat_variant WHERE id = ?;

selectMaxVariantIndex:
SELECT COALESCE(MAX(variant_index), -1) FROM chat_variant WHERE turn_id = ?;

deleteVariantsBySession:
DELETE FROM chat_variant WHERE turn_id IN (SELECT id FROM chat_turn WHERE session_id = ?);

countVariants:
SELECT COUNT(*) FROM chat_variant;
