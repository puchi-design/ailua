CREATE TABLE chat_variant (
    id TEXT NOT NULL PRIMARY KEY,
    turn_id TEXT NOT NULL,
    variant_index INTEGER NOT NULL,
    content TEXT NOT NULL,
    status TEXT NOT NULL,
    provider_profile_id TEXT,
    model TEXT,
    error_type TEXT,
    error_message TEXT,
    created_at_epoch_ms INTEGER NOT NULL,
    updated_at_epoch_ms INTEGER NOT NULL,
    rich_payloads_json TEXT,
    quote_message_id TEXT,
    quote_preview TEXT,
    FOREIGN KEY(turn_id) REFERENCES chat_turn(id) ON DELETE CASCADE
);

CREATE UNIQUE INDEX chat_variant_turn_index ON chat_variant(turn_id, variant_index);

insertVariant:
INSERT INTO chat_variant(id, turn_id, variant_index, content, status, provider_profile_id, model, error_type, error_message, created_at_epoch_ms, updated_at_epoch_ms, rich_payloads_json, quote_message_id, quote_preview)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectVariantsByTurn:
SELECT * FROM chat_variant WHERE turn_id = ? ORDER BY variant_index ASC;

selectVariantById:
SELECT * FROM chat_variant WHERE id = ?;

selectMaxVariantIndex:
SELECT COALESCE(MAX(variant_index), -1) FROM chat_variant WHERE turn_id = ?;

deleteVariantsBySession:
DELETE FROM chat_variant WHERE turn_id IN (SELECT id FROM chat_turn WHERE session_id = ?);

countVariants:
SELECT COUNT(*) FROM chat_variant;

updateVariant:
UPDATE chat_variant
SET content = ?, status = ?, error_type = ?, error_message = ?, updated_at_epoch_ms = ?, rich_payloads_json = COALESCE(?, rich_payloads_json)
WHERE id = ?;

updateRichPayloads:
UPDATE chat_variant SET rich_payloads_json = ?, updated_at_epoch_ms = ? WHERE id = ?;

recoverStreamingVariants:
UPDATE chat_variant
SET status = 'CANCELLED', error_type = 'INTERRUPTED', updated_at_epoch_ms = ?
WHERE status = 'STREAMING'
  AND turn_id IN (SELECT id FROM chat_turn WHERE session_id = ?);

selectStreamingCountBySession:
SELECT COUNT(*)
FROM chat_variant
WHERE status = 'STREAMING'
  AND turn_id IN (SELECT id FROM chat_turn WHERE session_id = ?);
