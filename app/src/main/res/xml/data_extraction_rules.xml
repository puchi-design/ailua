<?xml version="1.0" encoding="utf-8"?><!--
   Backup / transfer rules for devices running Android 12+
   (referenced by android:dataExtractionRules in AndroidManifest.xml).

   HARD RULE (spec §11 #6): the AI API secret store must never leave the device.
   shared_prefs/ailua_ai_secrets.xml is excluded from BOTH channels:
   - <cloud-backup>: Google Drive Auto Backup
   - <device-transfer>: device-to-device (D2D) transfer
   Android 11 and lower is covered by backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ailua_ai_secrets.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ailua_ai_secrets.xml"/>
    </device-transfer>
</data-extraction-rules>
