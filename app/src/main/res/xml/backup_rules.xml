<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for devices running Android 11 or lower
   (referenced by android:fullBackupContent in AndroidManifest.xml).

   The AI API key store MUST never leave the device:
   shared_prefs/ailua_ai_secrets.xml holds only Keystore-encrypted ciphertext,
   and even that ciphertext is excluded from every backup/transfer channel.
   See data_extraction_rules.xml for Android 12+ (cloud backup + device transfer).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="ailua_ai_secrets.xml"/>
</full-backup-content>
